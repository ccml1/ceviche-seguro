flowchart TB
  USR["Usuarios en Lima<br/>navegador / celular"]
  ATK["Atacante / bots"]
  GH["GitHub Actions<br/>CI: gitleaks · CodeQL · pruebas · npm audit<br/>CD: deploy a main + prueba de humo"]
  subgraph AZ["Microsoft Azure · Azure for Students · región Brazil South (la más cercana a Perú)"]
    subgraph EDGE["Borde (opcional por costo, solo demo)"]
      AFD["Azure Front Door Standard<br/>CDN + certificado TLS"]
      WAF["WAF en modo Prevención<br/>límite de peticiones por IP<br/>bloqueo de inyección SQL / XSS"]
    end
    subgraph RG["Resource Group practica-pfc"]
      subgraph VNET["Virtual Network 10.10.0.0/16 (segmentación de red)"]
        subgraph S1["snet-app 10.10.1.0/24"]
          VI["Integración VNet de App Service<br/>todo el tráfico de salida por la VNet<br/>service endpoint a Storage"]
        end
        subgraph S2["snet-db 10.10.2.0/24"]
          NSG{{"NSG nsg-db (firewall de red)<br/>permite solo snet-app → 5432<br/>deniega el resto"}}
          PG[("Azure Database for PostgreSQL<br/>Flexible Server B1ms · v16<br/>sin IP pública · TLS · backups 7 días")]
        end
      end
      subgraph ASP["App Service Plan Linux B1"]
        LB["Balanceador integrado<br/>de App Service"]
        APP["Web App Node 22 LTS<br/>HTTPS obligatorio · TLS 1.2 · FTPS off<br/>restricción de acceso: solo Front Door<br/>health check /health"]
      end
      MI(["Identidad administrada<br/>(IAM: rol Key Vault Secrets User)"])
      KV["Azure Key Vault<br/>DATABASE_URL · JWT_SECRET<br/>cadena del Storage"]
      BLOB[["Azure Blob Storage<br/>contenedor privado 'licencias'<br/>firewall: solo snet-app"]]
      AI["Application Insights + alerta 5xx<br/>(Monitor)"]
    end
  end
  USR -- HTTPS --> AFD --> WAF --> LB
  ATK -. bloqueado .-> WAF
  LB --> APP
  APP --> VI --> NSG --> PG
  VI --> BLOB
  APP --- MI -- "lee secretos" --> KV
  APP -- telemetría --> AI
  GH -- "publish profile en GitHub Secrets" --> APP
